{
  "name": "@seneris/nosework",
  "version": "0.3.0",
  "description": "Privacy-focused, self-hosted analytics for your app suite",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client/errors": {
      "import": "./dist/client/errors.js",
      "types": "./dist/client/errors.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [
    "analytics",
    "privacy",
    "self-hosted",
    "gdpr",
    "cookieless"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "ua-parser-js": "^2.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/ua-parser-js": "^0.7.39",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
